{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 90
  },
  "overrides": [
    {
      "includes": ["options/**/*.html", "popup/**/*.html"],
      "linter": {
        "rules": {
          "a11y": {
            "useHeadingContent": "off",
            "noLabelWithoutControl": "off"
          }
        }
      }
    }
  ]
}
